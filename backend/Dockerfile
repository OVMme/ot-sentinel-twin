# OT Sentinel Twin - backend (FastAPI + simulation + detection)
# Build context: repository root (see docker-compose.yml). Synthetic data only; runs unprivileged.
FROM python:3.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir . \
    && useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin otst \
    && mkdir -p /data \
    && chown -R otst:otst /data

# Reference evaluation results (generated by scripts/run_evaluation.py) shown until a new run is made
COPY datasets/synthetic/evaluation_results.json /app/reference/evaluation_results.json

USER otst

ENV OTST_DATABASE_URL=sqlite:////data/ot_sentinel.db \
    OTST_AUTOSTART=true \
    OTST_REFERENCE_EVALUATION=/app/reference/evaluation_results.json

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--ws-max-size", "65536", "--no-server-header", "--proxy-headers", "--forwarded-allow-ips", "*"]
