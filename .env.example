# OT Sentinel Twin - example configuration. Copy to .env and adjust. Never commit real secrets.
# All values are optional; defaults are safe for local use.

# Storage (SQLite by default; any SQLAlchemy URL such as postgresql+psycopg://... is possible)
OTST_DATABASE_URL=sqlite:///./data/ot_sentinel.db

# Comma-separated browser origins allowed for CORS and WebSocket connections
OTST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Start the simulation automatically on boot
OTST_AUTOSTART=true

# Public demo deployments: run the scripted storyline and refuse all state-changing API calls
OTST_DEMO_MODE=false
OTST_READ_ONLY=false

# Optional shared secret required (header X-API-Key) for state-changing calls. Leave empty locally.
OTST_API_TOKEN=

# Resource limits
OTST_MAX_SPEED=10
OTST_RATE_LIMIT_PER_MINUTE=240
OTST_MAX_BODY_BYTES=65536
OTST_RETENTION_RUNS=12
OTST_MAX_SAMPLES_PER_RUN=60000
OTST_WS_MAX_CLIENTS=25
